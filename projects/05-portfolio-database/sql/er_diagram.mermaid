erDiagram
    securities ||--o{ trades : "has"
    securities ||--o{ prices : "has"
    securities ||--o{ dividends : "pays"
    securities {
        TEXT ticker PK
        TEXT name
        TEXT sector "NULL for funds; category used instead"
        TEXT asset_type "STOCK/ETF/FUND/BOND/OTHER"
    }
    trades {
        INTEGER trade_id PK
        TEXT ticker FK
        TEXT trade_date
        TEXT side "BUY or SELL"
        REAL quantity "abs, fractional OK"
        REAL price
        REAL fees
        TEXT source_ref UK "idempotency key"
    }
    prices {
        TEXT ticker PK, FK
        TEXT date PK
        REAL close "plus open, high, low"
        INTEGER volume
    }
    dividends {
        TEXT ticker PK, FK
        TEXT ex_date PK
        REAL amount "total cash received, USD"
    }
